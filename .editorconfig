root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp}]
indent_style = space
indent_size = 2
max_line_length = 80

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[justfile]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
